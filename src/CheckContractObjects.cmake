if(NOT DEFINED BINARY_DIR)
    message(FATAL_ERROR "BINARY_DIR not set")
endif()

file(GLOB sources ${BINARY_DIR}/contract_*.cpp)
if(sources STREQUAL "")
    message(FATAL_ERROR "no generated contract sources under ${BINARY_DIR}")
endif()

set(missing "")
set(stale "")

foreach(source ${sources})
    get_filename_component(name ${source} NAME_WE)
    file(GLOB object ${BINARY_DIR}/CMakeFiles/${name}.dir/${name}.cpp.o)
    if(object STREQUAL "")
        list(APPEND missing ${name})
    else()
        string(REPLACE "contract_" "" module ${name})
        set(header ${SOURCE_DIR}/${module}/include/${module}/${module}.hpp)
        if(NOT EXISTS ${header})
            set(header ${SOURCE_DIR}/ui/${module}/include/${module}/${module}.hpp)
        endif()
        if(EXISTS ${header} AND ${header} IS_NEWER_THAN ${object})
            list(APPEND stale ${module})
        endif()
    endif()
endforeach()

if(missing)
    message(FATAL_ERROR "contract objects never built: ${missing} - run: cmake --build <dir>")
endif()
if(stale)
    message(FATAL_ERROR "header newer than its contract object: ${stale} - run: cmake --build <dir>")
endif()

list(LENGTH sources count)
message(STATUS "contract headers compiled: ${count}")
